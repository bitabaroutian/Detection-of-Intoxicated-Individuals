   "source": [
    "# Process frames function\n",
    "def process_frames(arr):\n",
    "    if isinstance(arr, np.ndarray):\n",
    "        arr = arr[:100]\n",
    "        if len(arr) < 60:\n",
    "            return None\n",
    "        elif len(arr) < 100:\n",
    "            arr = np.pad(arr, ((0, 100 - len(arr)), (0, 0), (0, 0)), mode='edge')\n",
    "        return arr\n",
    "    return None\n"
   ]
